#!/usr/bin/env bash
#
# Build the image through cqfd in review or release mode.
#
# Mode is detected from HEAD:
#   release - HEAD has an annotated v* tag pointing at it
#   review  - anything else
#
# BUILD_MODE=review|release forces a mode (release still requires the tag).
#
# Both modes package the image with cqfd --release into
# meta_luckfox-<version>.tar.gz plus a .sha256. Review versions come from
# git describe; release versions are the tag. Release also generates
# CHANGELOG-release.md for the GitHub release notes.
#
# When GITHUB_OUTPUT is set, version= and archive= are written to it.
#
# Environment:
#   DL_DIR      (required) shared downloads directory, reused by all modes
#   SSTATE_DIR  (required) shared sstate-cache directory, used by review;
#               release ignores it and uses a fresh, empty sstate-cache

ME=$0

die() {
	printf "\033[31m${ME}: error: %s\033[0m\n" "$*" >&2
	exit 1
}

log() {
	printf "\033[32m${ME}: %s\033[0m\n" "$*"
}

: "${DL_DIR:?DL_DIR must be set to the shared downloads directory}"
: "${SSTATE_DIR:?SSTATE_DIR must be set to the shared sstate-cache directory}"
: "${BUILD_MODE:=auto}"
: "${RUNNER_TEMP:=${TMPDIR:-/tmp}}"

missing=()
for prog in git docker sha256sum mktemp; do
	if ! command -v "$prog" > /dev/null 2>&1; then
		missing+=("$prog")
	fi
done
if [ "${#missing[@]}" -ne 0 ]; then
	die "missing required programs: ${missing[*]}"
fi

if [ $# -ne 0 ]; then
	die "usage: $ME (configure with BUILD_MODE, DL_DIR, SSTATE_DIR)"
fi

repo_root=$(git rev-parse --show-toplevel) || die "not inside a git repository"
if ! cd "$repo_root"; then
	die "changing directory to $repo_root failed"
fi

cqfd="$repo_root/scripts/cqfd"

# cqfd splits docker_run_args on whitespace, so paths must not contain any
check_dir() {
	local name=$1
	local dir=$2

	if [ -z "$dir" ]; then
		die "$name is not set"
	fi
	case "$dir" in
	/*) ;;
	*) die "$name must be an absolute path: $dir" ;;
	esac
	case "$dir" in
	*[[:space:]]*) die "$name must not contain whitespace: $dir" ;;
	esac
	if [ ! -d "$dir" ]; then
		die "$name does not exist: $dir"
	fi
	if [ ! -w "$dir" ]; then
		die "$name is not writable: $dir"
	fi
}

# Annotated v* tag pointing at HEAD, or nothing
release_tag() {
	local tags
	local tag
	local found=""

	tags=$(git tag --points-at HEAD --list 'v*') || die "listing tags at HEAD failed"
	for tag in $tags; do
		if [ "$(git cat-file -t "refs/tags/$tag")" != "tag" ]; then
			continue
		fi
		if [ -n "$found" ]; then
			die "multiple annotated v* tags point at HEAD: $found $tag"
		fi
		found=$tag
	done
	printf "%s" "$found"
}

tag=$(release_tag) || exit 1

case "$BUILD_MODE" in
auto)
	if [ -n "$tag" ]; then
		mode=release
	else
		mode=review
	fi
	;;
review)
	mode=review
	;;
release)
	if [ -z "$tag" ]; then
		die "BUILD_MODE=release but HEAD has no annotated v* tag"
	fi
	mode=release
	;;
*)
	die "invalid BUILD_MODE: $BUILD_MODE (expected auto, review, or release)"
	;;
esac

check_dir DL_DIR "$DL_DIR"

if [ "$mode" = release ]; then
	CI_VERSION=$tag

	log "creating empty release sstate-cache"
	SSTATE_DIR=$(mktemp --directory "$RUNNER_TEMP/sstate-release.XXXXXX") ||
		die "creating empty release sstate-cache failed"
	log "creating empty release sstate-cache succeeded: $SSTATE_DIR"
	# shellcheck disable=SC2064
	trap "rm -rf '$SSTATE_DIR'" EXIT

	# Never let a previous build's TMPDIR leak into a release
	log "removing stale build/tmp"
	if ! rm -rf "$repo_root/build/tmp"; then
		die "removing stale build/tmp failed"
	fi
	log "removing stale build/tmp succeeded"
else
	CI_VERSION=$(git describe --tags --always --dirty) ||
		die "determining version with git describe failed"
fi

check_dir SSTATE_DIR "$SSTATE_DIR"

# Read by the docker_run_args of .cqfdrc
export CI_VERSION DL_DIR SSTATE_DIR
export CQFD_NO_SYSTEM_GIT_CONFIG="true"
export CQFD_NO_SSH_CONFIG="true"

log "mode: $mode"
log "version: $CI_VERSION"
log "DL_DIR: $DL_DIR"
log "SSTATE_DIR: $SSTATE_DIR"

if [ "$mode" = release ]; then
	log "generating release changelog for $CI_VERSION"
	if ! "$cqfd" run "cog changelog --at '$CI_VERSION' > CHANGELOG-release.md"; then
		die "generating release changelog for $CI_VERSION failed"
	fi
	log "generating release changelog for $CI_VERSION succeeded"
fi

archive="meta_luckfox-$CI_VERSION.tar.gz"

log "removing stale archives"
if ! rm -f meta_luckfox-*.tar.gz meta_luckfox-*.tar.gz.sha256; then
	die "removing stale archives failed"
fi
log "removing stale archives succeeded"

log "building and packaging $mode $CI_VERSION"
if ! "$cqfd" --release; then
	die "building and packaging $mode $CI_VERSION failed"
fi
log "building and packaging $mode $CI_VERSION succeeded"

if [ ! -f "$archive" ]; then
	die "release archive not found: $archive"
fi

log "writing checksum for $archive"
if ! sha256sum "$archive" > "$archive.sha256"; then
	die "writing checksum for $archive failed"
fi
log "writing checksum for $archive succeeded"

if [ -n "${GITHUB_OUTPUT:-}" ]; then
	log "writing step outputs"
	if ! printf "version=%s\narchive=%s\n" "$CI_VERSION" "$archive" >> "$GITHUB_OUTPUT"; then
		die "writing step outputs failed"
	fi
	log "writing step outputs succeeded"
fi
