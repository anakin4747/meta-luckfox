From 9d9dd7fe44cdcca77317df14d5a463bd0246501c Mon Sep 17 00:00:00 2001
From: Anakin Childerhose <anakin@childerhose.ca>
Date: Mon, 12 Oct 2026 03:15:24 -0400
Subject: [PATCH] ARM: dts: rockchip: add Luckfox Pico Ultra W

The Luckfox Pico Ultra W is a board based on the Rockchip RV1106G3
with 8GB of eMMC, an SDIO Wi-Fi/Bluetooth module, Ethernet and USB.

Add a minimal device tree enabling the debug console on UART2_M1
through the FIQ debugger and the eMMC, which is the only boot medium.

Upstream-Status: Pending
Signed-off-by: Anakin Childerhose <anakin@childerhose.ca>
---
 arch/arm/boot/dts/rockchip/Makefile           |  1 +
 .../rockchip/rv1106g-luckfox-pico-ultra-w.dts | 34 +++++++++++++++++++
 2 files changed, 35 insertions(+)
 create mode 100644 arch/arm/boot/dts/rockchip/rv1106g-luckfox-pico-ultra-w.dts

diff --git a/arch/arm/boot/dts/rockchip/Makefile b/arch/arm/boot/dts/rockchip/Makefile
index 9bb4300..7525c5b 100644
--- a/arch/arm/boot/dts/rockchip/Makefile
+++ b/arch/arm/boot/dts/rockchip/Makefile
@@ -72,6 +72,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += \
 	rv1106g-evb2-v12-nofastae-spi-nor.dtb \
 	rv1106g-evb2-v12-spi-nand-tb.dtb \
 	rv1106g-evb2-v12-wakeup.dtb \
+	rv1106g-luckfox-pico-ultra-w.dtb \
 	rv1106g-smart-door-lock-rmsl-v10.dtb \
 	rv1106g-smart-door-lock-rmsl-v12.dtb \
 	rv1106g-uvc-demo-v10.dtb \
diff --git a/arch/arm/boot/dts/rockchip/rv1106g-luckfox-pico-ultra-w.dts b/arch/arm/boot/dts/rockchip/rv1106g-luckfox-pico-ultra-w.dts
new file mode 100644
index 0000000..8a44e67
--- /dev/null
+++ b/arch/arm/boot/dts/rockchip/rv1106g-luckfox-pico-ultra-w.dts
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Luckfox Pico Ultra W (Rockchip RV1106G3, 8GB eMMC)
+ */
+
+/dts-v1/;
+
+#include "rv1106g3.dtsi"
+
+/ {
+	model = "Luckfox Pico Ultra W";
+	compatible = "luckfox,pico-ultra-w", "rockchip,rv1106g3", "rockchip,rv1106";
+
+	chosen {
+		bootargs = "earlycon=uart8250,mmio32,0xff4c0000 console=ttyFIQ0 root=PARTLABEL=rootfs rootfstype=ext4 rootwait";
+	};
+};
+
+/* Debug UART2_M1 (GPIO1_B2 TX / GPIO1_B3 RX) on header P1 */
+&fiq_debugger {
+	rockchip,irq-mode-enable = <1>;
+	status = "okay";
+};
+
+/* 8GB eMMC, the only boot medium on this board */
+&emmc {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	non-removable;
+	rockchip,default-sample-phase = <90>;
+	no-sdio;
+	no-sd;
+	status = "okay";
+};
-- 
